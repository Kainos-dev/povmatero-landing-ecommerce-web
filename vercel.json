{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/restock-send.js": { "maxDuration": 60 },
    "api/push-send.js": { "maxDuration": 60 },
    "api/cron-pedidos.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron-pedidos",
      "schedule": "0 12 * * *"
    }
  ],
  "images": {
    "sizes": [
      128,
      256,
      384,
      640,
      828,
      1080,
      1200,
      1600
    ],
    "qualities": [
      75
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "gubrehbalkfvzwsndbcv.supabase.co",
        "pathname": "/storage/v1/object/public/product-images/**"
      }
    ],
    "localPatterns": [
      {
        "pathname": "^/images/.*$",
        "search": ""
      }
    ]
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin/"
        }
      ]
    },
    {
      "source": "/admin/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/producto/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Slackbot|TelegramBot|Discordbot|LinkedInBot|Pinterest|SkypeUriPreview|Embedly|redditbot|Applebot).*"
        }
      ],
      "destination": "/api/producto-meta?slug=:slug"
    },
    {
      "source": "/producto/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/cuenta",
      "destination": "/index.html"
    },
    {
      "source": "/yerbas",
      "destination": "/yerbas.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ]
}
